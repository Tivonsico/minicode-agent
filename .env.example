# Copy to .env and fill locally. Do not commit real credentials.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL=GLM-5.3-Flash
# Required: verify this model's limits with your provider, then fill both values.
# No assumed model window or output limit is supplied.
CONTEXT_WINDOW=
MAX_OUTPUT_TOKENS=
REQUEST_TIMEOUT=120
SHELL_EXECUTABLE=powershell.exe
