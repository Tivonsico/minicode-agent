# Copy to .env and fill locally. Do not commit real credentials.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL=GLM-5.3-Flash
# Context window is resolved automatically; no CONTEXT_WINDOW setting.
# Optional per-request output budget; blank uses the application default,
# capped by the discovered model output limit.
# MAX_OUTPUT_TOKENS=
# Optional for custom gateways without limits in /models: a Models.dev provider ID.
# MODEL_CATALOG_PROVIDER=openai
REQUEST_TIMEOUT=120
# Optional: defaults to /bin/sh on macOS/Linux, powershell.exe on Windows.
# SHELL_EXECUTABLE=
# Optional: full path to an installed Codex CLI with sandbox-state-json support.
# MINICODE_CODEX_PATH=

# Storage: local (default) or mysql. Browser settings take precedence over this
# file; process environment variables take precedence over browser settings.
# MINICODE_STORAGE_MODE=local
# MINICODE_MYSQL_HOST=127.0.0.1
# MINICODE_MYSQL_PORT=3306
# MINICODE_MYSQL_DATABASE=minicode
# MINICODE_MYSQL_USER=minicode
# MINICODE_MYSQL_PASSWORD=
# Optional: verify remote server certificate and hostname with this CA file.
# MINICODE_MYSQL_SSL_CA=
# MINICODE_MYSQL_POOL_SIZE=8
